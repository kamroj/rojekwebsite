---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HsConfiguratorIslandWithResources from '../../components/_astro/islands-with-resources/HsConfiguratorIslandWithResources.astro';
import { fetchHsPricing } from '../../lib/sanity/hsPricing.js';

const hsPricing = await fetchHsPricing();
---

<SiteLayout
  lang="en"
  title="HS Configurator – ROJEK | Lift-and-slide doors"
  description="Configure an HS system: variants, colours and options. ROJEK configurator for lift-and-slide doors."
>
  <HsConfiguratorIslandWithResources lang="en" hydrate="load" viewProps={{ pricing: hsPricing }} />
</SiteLayout>
