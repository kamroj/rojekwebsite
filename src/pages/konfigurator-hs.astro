---
import SiteLayout from '../layouts/SiteLayout.astro';
import HsConfiguratorIslandWithResources from '../components/_astro/islands-with-resources/HsConfiguratorIslandWithResources.astro';
import { fetchHsPricing } from '../lib/sanity/hsPricing.js';

const hsPricing = await fetchHsPricing();
---

<SiteLayout
  lang="pl"
  title="Konfigurator HS – ROJEK | Drzwi podnoszono-przesuwne"
  description="Skonfiguruj system HS: warianty, kolory i opcje. Narzędzie konfiguratora ROJEK dla drzwi podnoszono-przesuwnych."
>
  <HsConfiguratorIslandWithResources lang="pl" hydrate="load" viewProps={{ pricing: hsPricing }} />
</SiteLayout>
