---
import SiteLayout from '../layouts/SiteLayout.astro';
import NotFoundContent from '../components/_astro/NotFoundContent.astro';
---

<SiteLayout lang="pl" title="404 — Nie znaleziono strony" description="Strona, której szukasz, nie istnieje lub została przeniesiona." noindex={true}>
  <NotFoundContent
    title="Nie znaleziono strony"
    text="Strona, której szukasz, mogła zostać przeniesiona albo nie istnieje."
    homeHref="/"
    homeLabel="Strona główna"
    productsHref="/produkty"
    productsLabel="Zobacz produkty"
  />
</SiteLayout>
